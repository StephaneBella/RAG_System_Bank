# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node / frontend
node_modules/
dist/
*.tsbuildinfo

# Environment files (secrets: JWT keys, DB credentials) - never in Git
.env
.env.*
!.env.example
!*.env.example

# Data corpus (regenerated by ingestion scripts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Testing / tooling
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Copy this file to .env and fill in real values.
# .env is gitignored: real secrets must NEVER be committed.

APP_ENV=dev
APP_NAME=RAG Document Library API
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/rag_project_dev
JWT_SECRET_KEY=change-me-generate-a-real-secret
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

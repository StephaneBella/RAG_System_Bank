APP_ENV=dev
APP_NAME=RAG for Bank Document Library API

DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@localhost:5432/rag_project_dev

JWT_SECRET_KEY=replace-with-a-generated-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173"]

SEED_ON_STARTUP=true
SEED_ADMIN_EMAIL=admin@banque.fr
SEED_ADMIN_PASSWORD=replace-with-a-long-dev-password

# Suspicious activity detection (GET /audit/alerts) - optional, defaults shown
# ALERT_LOOKBACK_HOURS=24
# ALERT_LOGIN_FAILURES_USER_THRESHOLD=5
# ALERT_LOGIN_FAILURES_IP_THRESHOLD=10
# ALERT_LOGIN_FAILURES_WINDOW_MINUTES=15
# ALERT_TOKEN_FAILURES_USER_THRESHOLD=5
# ALERT_TOKEN_FAILURES_IP_THRESHOLD=10
# ALERT_MISSING_TOKEN_IP_THRESHOLD=30
# ALERT_TOKEN_FAILURES_WINDOW_MINUTES=15
# ALERT_FORBIDDEN_THRESHOLD=10
# ALERT_FORBIDDEN_WINDOW_MINUTES=30
# ALERT_CROSS_DEPARTMENT_THRESHOLD=3
# ALERT_CROSS_DEPARTMENT_WINDOW_MINUTES=30
# ALERT_ADMIN_PROBING_THRESHOLD=3
# ALERT_ADMIN_PROBING_WINDOW_MINUTES=60
# ALERT_SPIKE_MIN_EVENTS=60
# ALERT_SPIKE_FACTOR=5.0
# ALERT_SPIKE_WINDOW_MINUTES=10
# ALERT_SPIKE_BASELINE_DAYS=7
# ALERT_SPIKE_MIN_ACTIVE_WINDOWS=6
# ALERT_DOCUMENT_ENUMERATION_THRESHOLD=4
# ALERT_DOCUMENT_ENUMERATION_WINDOW_MINUTES=30
# ALERT_SEARCH_BURST_THRESHOLD=30
# ALERT_SEARCH_BURST_WINDOW_MINUTES=1

# --- RAG assistant (optional) ------------------------------------------------
# Disabled by default. With RAG_ENABLED=false the API starts without the "rag"
# dependency group and POST /rag/chat and /rag/chat/stream answer 503.
# The only LLM provider is Groq (ChatGroq). Groq is an external API: the RAG can
# only be enabled together with ALLOW_EXTERNAL_LLM=true (decision H1).
RAG_ENABLED=false

# Required when RAG_ENABLED=true (the API refuses to start otherwise):
# ALLOW_EXTERNAL_LLM=true
# Groq model identifier (a leading "groq:" is removed before the call)
# LLM_MODEL=
# Secret: never commit a real value
# GROQ_API_KEY=
# Internal Qdrant server: http(s) URL whose host is in QDRANT_INTERNAL_HOSTS
# QDRANT_URL=http://127.0.0.1:6333
# Secret: never commit a real value
# QDRANT_API_KEY=

# Optional (defaults shown)
# QDRANT_COLLECTION=rag_system_bank
# QDRANT_INTERNAL_HOSTS=["127.0.0.1","localhost","qdrant"]
# Must match the scheme of QDRANT_URL (true for https://)
# QDRANT_HTTPS=false
# Per RAG request: provider calls, characters sent per call, seconds per call
# MAX_PROVIDER_CALLS=12
# MAX_PROMPT_CHARS=32000
# TIMEOUT_SECONDS=30.0

# Declared and validated, but not used by the code yet
# QDRANT_TIMEOUT=10
# QDRANT_INGEST_API_KEY=
# EMBEDDING_CACHE_DIR=
# EMBEDDING_DEVICE=
# EMBEDDING_OFFLINE=true
# The embedding model is read from the process environment (not from this file)
# by Data_preparation/vectorisation.py; default:
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
